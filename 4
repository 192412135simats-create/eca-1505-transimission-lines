clear;
clc;

ZR = 100;
Zo = 600;
f = 100 * 10^6;

// Wavelength
lo = 300 / (f * 10^-6);

// Point of attachment
Ls = (lo / (2 * %pi)) * atan(sqrt(ZR / Zo));

printf("- Point of attachment = %f cm\n", round(Ls * 100 * 10) / 10);

// Length of the short-circuited stub
Lt = (lo / (2 * %pi)) * (%pi + atan(sqrt(ZR * Zo) / (ZR - Zo)));

printf("- Length of the short-circuited stub = %f cm\n", round(Lt * 100));
